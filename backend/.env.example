# Neon PostgreSQL connection string - get this from your Neon project dashboard
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Cashfree credentials - set these in Render Environment Variables
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Public Render URL, for example:
# https://atulride.onrender.com
PUBLIC_URL=

# Render provides PORT automatically; local default is 5000
PORT=5000
